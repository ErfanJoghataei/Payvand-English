{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "cnnstring": "Server=(localdb)\\MSSQLLocalDB;Database=PayvandEnglishDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Kavenegar": {
    "Sender": "replace-with-sender",
    "receptor": "replace-with-development-phone-number",
    "api": "replace-with-api-key"
  },
  "Authentication": {
    "Enabled": false,
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "GoogleSafeBrowsing": {
    "Key": "replace-with-api-key"
  },
  "UsageLimits": {
    "GuestMonthlyLinks": 10,
    "UserMonthlyLinks": 100,
    "GuestMonthlyQrCodes": 10,
    "UserMonthlyQrCodes": 100
  }
}
