@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Page not found | Payvand</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="shortcut icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/Home/404.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <!-- Background Abstract Shapes -->
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="broken-link-icon">
            <i class="fas fa-link"></i>
        </div>
        <div class="expired-icon">
            <i class="fas fa-clock"></i>
        </div>
    </div>

    <!-- Main Content -->
    <div class="error-container">
        <div class="error-card">
            <!-- Logo -->
            <a href="/" class="error-logo" style="display:block;text-decoration:none;color:inherit;">
                <div class="logo-icon">
                    <i class="fas fa-link"></i>
                </div>
                <div class="logo-text">Payvand</div>
            </a>

            <!-- Error Code -->
            <div class="error-code">404</div>

            <!-- Link Status Badge -->
            <div class="link-status">
                <i class="fas fa-exclamation-circle"></i>
                Expired link
            </div>

            <!-- Main Message -->
            <h1 class="error-title">This link has expired</h1>
            <p class="error-message">
                This link is no longer valid or its destination has changed.
                Check the URL or return to the home page.
            </p>

            <!-- Animated Illustration -->
            <div class="error-illustration">
                <svg class="link-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Broken Link SVG -->
                    <circle cx="100" cy="100" r="80" stroke="url(#grad1)" stroke-width="2" fill="none" class="link-path"/>
                    <path d="M70 70 L130 130" stroke="url(#grad1)" stroke-width="3" stroke-linecap="round" class="link-path"/>
                    <path d="M130 70 L70 130" stroke="url(#grad1)" stroke-width="3" stroke-linecap="round" class="link-path"/>
                    <circle cx="100" cy="100" r="25" fill="white" stroke="url(#grad1)" stroke-width="2" class="link-path"/>
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#4361EE;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#7209B7;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <!-- Action Buttons -->
            <div class="button-group">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i>
                    Home
                </a>
                <button class="btn btn-secondary" id="backButton">
                    <i class="fas fa-arrow-right"></i>
                    Back
                </button>
            </div>

        </div>
    </div>


    <script src="/js/Home/404.js" asp-append-version="true"></script>
</body>
</html>
