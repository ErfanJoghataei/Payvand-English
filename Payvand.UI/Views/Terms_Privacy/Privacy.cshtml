@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Payvand privacy policy for links, accounts, cookies, click analytics, and data retention." />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}/Terms_Privacy/Privacy")" />
    <meta property="og:site_name" content="Payvand" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Privacy Policy | Payvand" />
    <meta property="og:description" content="How Payvand handles account data, links, clicks, cookies, and abuse reports." />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/Terms_Privacy/Privacy")" />
    <title>Privacy Policy | Payvand</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" asp-append-version="true">
    <link rel="shortcut icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Terms&Privacy/Privacy.css">
   <link href="/css/Home/Contact.css" asp-append-version="true" rel="stylesheet" />


    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/english.css" asp-append-version="true" />
</head>
<body>
    <!-- هدر ساده -->
    <header class="simple-header">
        <div class="header-container">
            <a href="/" class="logo">
                <span>Payvand</span>
            </a>
            <ul class="nav-links">
                <li><a href="@Url.Action("Index","Home")">Home</a></li>
                <li><a href="@Url.Action("Terms","Terms_Privacy")">Terms of use</a></li>
            </ul>
        </div>
    </header>

    <!-- محتوای اصلی -->
    <main class="privacy-container">
        <header class="page-header">
            <h1 class="page-title">Payvand Privacy Policy</h1>
            <p class="page-subtitle">Last updated: May 5, 2026</p>
        </header>

        <div class="summary-card">
            <i class="fas fa-shield-alt summary-icon"></i>
            <div class="summary-content">
                <h3>Respecting your privacy</h3>
                <p>Payvand respects your privacy. This policy explains what data we collect, why we use it, and what choices you have.</p>
            </div>
        </div>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">1</span>
                <h2 class="section-title">Information we collect</h2>
            </div>
            <div class="section-content">
                <p>To provide the service, we may store:</p>
                <ul>
                    <li>Original and shortened URLs and creation time</li>
                    <li>User or guest identifiers</li>
                    <li>Account phone number, username, or display name</li>
                    <li>Hashed passwords and temporary one-time codes</li>
                    <li>Created QR codes, contact messages, and abuse reports</li>
                    <li>Technical click data</li>
                </ul>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">2</span>
                <h2 class="section-title">Click data and analytics</h2>
            </div>
            <div class="section-content">
                <p>When someone opens a short link, we may record the time, IP address, user agent, browser, operating system, device type, country, city, and referrer. This supports analytics, security, abuse detection, and service improvement.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">3</span>
                <h2 class="section-title">Cookies</h2>
            </div>
            <div class="section-content">
                <p>Cookies support guest sessions, link limits, and signed-in sessions. You can manage them in your browser settings. Disabling cookies may affect parts of the site.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">4</span>
                <h2 class="section-title">Accounts and authentication</h2>
            </div>
            <div class="section-content">
                <p>Signing in and account management may use a phone number, password, or one-time code. Passwords are stored as hashes; one-time codes are used for sign in or password recovery.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">5</span>
                <h2 class="section-title">How we use information</h2>
            </div>
            <div class="section-content">
                <p>We use information to:</p>
                <ul>
                    <li>Create and manage short links</li>
                    <li>Show analytics and create QR codes</li>
                    <li>Authenticate users and limit abuse</li>
                    <li>Check unsafe links and review abuse reports</li>
                    <li>Respond to messages and improve the service</li>
                </ul>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">6</span>
                <h2 class="section-title">Link safety checks</h2>
            </div>
            <div class="section-content">
                <p>To reduce harmful links, URLs may be checked with security services such as Google Safe Browsing. The URL is sent to that service for a safety check.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">7</span>
                <h2 class="section-title">Information sharing</h2>
            </div>
            <div class="section-content">
                <p>Payvand does not sell user data or share it for advertising. Data may be processed or disclosed when needed to deliver the service, check safety, maintain systems, or meet legal requirements.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">8</span>
                <h2 class="section-title">Retention and deletion</h2>
            </div>
            <div class="section-content">
                <p>Links, click data, and QR codes are kept as long as needed for the service, security, reports, or technical requirements. Signed-in users can delete their links and QR codes from the dashboard. Contact support to request account data review or deletion.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">9</span>
                <h2 class="section-title">Data security</h2>
            </div>
            <div class="section-content">
                <p>We use authentication, password hashing, access limits, and suspicious link checks to protect data. No internet service can guarantee absolute security.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">10</span>
                <h2 class="section-title">Contact information</h2>
            </div>
            <div class="section-content">
                <p>For privacy questions, deletion requests, or problem reports, contact us through the website form or email <a href="mailto:payvandweb@gmail.com">payvandweb@gmail.com</a> to get in touch.</p>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <span class="section-number">11</span>
                <h2 class="section-title">Changes to this policy</h2>
            </div>
            <div class="section-content">
                <p>We may update this policy. The new version and its update date will appear on this page.</p>
            </div>
        </section>
    </main>

    <!-- فوتر ساده -->
    <footer class="simple-footer">
        <div class="footer-content">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>Payvand</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">
                        A smarter way to share links
                    </p>
                </div>

                <div class="footer-section">
                    <h4>Documents</h4>
                    <ul class="footer-links">
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="@Url.Action("Terms","Terms_Privacy")">Terms of use</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Contact</h4>
                    <ul class="footer-links">
                            <li><a href="mailto:payvandweb@gmail.com">payvandweb@gmail.com</a></li>
                        <li><a href="#" id="ContactBtn">Contact form</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 Payvand. All rights reserved.</p>
            </div>
        </div>
    </footer>
    <!-- Contact Modal -->
    <div class="modal-overlay" id="contactModal">
        <div class="modal-container">
            <div class="modal-header">
                <button class="close-button" id="closeModal">&times;</button>
                <h2 class="modal-title">Contact us</h2>
            </div>
            <div class="modal-body">
                <form id="contactForm">
                    <div class="form-group">
                        <label class="form-label" for="name">Full name</label>
                        <input type="text" id="name" class="form-control" placeholder="Enter your full name" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" id="email" class="form-control" placeholder="Enter a valid email address" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="subject">Subject</label>
                        <input type="text" id="subject" class="form-control" placeholder="Enter your subject" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="message">Message</label>
                        <textarea id="message" class="form-control" placeholder="Write your message..." required></textarea>
                    </div>
                    <button type="submit" class="submit-button">Send message</button>
                </form>
                <div class="contact-info">
                    <div class="info-item"><img src="/Images/Icons/Email.png" class="icon icon-sm" alt=""><span>Email: info@payvand.ir</span></div>
                    <div class="info-item"><img src="/Images/Icons/Phone.png" class="icon icon-sm" alt=""><span>Phone: 021-12345678</span></div>
                    <div class="info-item"><img src="/Images/Icons/Location.png" class="icon icon-sm" alt=""><span>Location: Karaj, Iran</span></div>
                </div>
            </div>
        </div>
    </div>
    

    <script src="/js/Home/Contact.js" asp-append-version="true"  ></script>
  
</body>
</html>

