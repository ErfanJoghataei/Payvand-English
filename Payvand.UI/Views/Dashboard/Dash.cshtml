            </div>

            <div id="analyticsDetailView" class="hidden">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-chart-bar"></i>
                        Link analytics
                    </h2>
                </div>

                <div style="margin-bottom: 1rem;">
                    <button type="button" id="analyticsBackToList" class="analytics-back-btn">
                        Back to links
                    </button>
                </div>

                <div id="analyticsDetails">
                    @foreach (var links in Model.ShortenedLinks)
                    {
                        var logs = links.ClickLogs
                            .OrderByDescending(log => log.ClickedAt)
                            .ToList();
                        var totalClicks = logs.Count;
                        var uniqueCities = logs
                            .Select(log => string.IsNullOrWhiteSpace(log.City) ? "Unknown" : log.City)
                            .Distinct()
                            .Count();
                        var topReferrer = logs
                            .Where(log => !string.IsNullOrWhiteSpace(log.Referre))
                            .GroupBy(log => log.Referre)
                            .OrderByDescending(group => group.Count())
                            .Select(group => group.Key)
                            .FirstOrDefault() ?? "Unknown";
                        var topDevice = logs
                            .GroupBy(log => log.DeviceType.ToString())
                            .OrderByDescending(group => group.Count())
                            .Select(group => group.Key)
                            .FirstOrDefault() ?? "Unknown";
                        var hourlyStats = Enumerable.Range(0, 24)
                            .Select(hour => new
                            {
                                Hour = hour,
                                Count = logs.Count(log => ToIranTime(log.ClickedAt).Hour == hour)
                            })
                            .ToList();
                        var maxHourClicks = Math.Max(1, hourlyStats.Max(item => item.Count));
                        var cityStats = logs
                            .GroupBy(log => string.IsNullOrWhiteSpace(log.City) ? "Unknown" : log.City)
                            .Select(group => new
                            {
                                City = group.Key,
                                Count = group.Count()
                            })
                            .OrderByDescending(item => item.Count)
                            .ThenBy(item => item.City)
                            .Take(8)
                            .ToList();
                        var maxCityClicks = Math.Max(1, cityStats.Any() ? cityStats.Max(item => item.Count) : 1);
                        var shortUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/{links.ShorteCode}";

                        <div class="analytics-detail-panel hidden" data-analytics-detail-id="@links.Id">
                            <div class="analytics-link-card">
                                <div class="analytics-link-main">
                                    <div class="analytics-short">@shortUrl</div>
                                    <div class="analytics-original" title="@links.OriginalUrl">@links.OriginalUrl</div>
                                </div>
                            </div>

                            <div class="analytics-summary-grid">
                                <div class="analytics-summary-card">
                                    <div class="analytics-summary-label">Total clicks</div>
                                    <div class="analytics-summary-value">@totalClicks</div>
                                </div>
                                <div class="analytics-summary-card">
                                    <div class="analytics-summary-label">Unique cities</div>
                                    <div class="analytics-summary-value">@uniqueCities</div>
                                </div>
                                <div class="analytics-summary-card">
                                    <div class="analytics-summary-label">Top device</div>
                                    <div class="analytics-summary-value">@topDevice</div>
                                </div>
                                <div class="analytics-summary-card">
                                    <div class="analytics-summary-label">Top referrer</div>
                                    <div class="analytics-summary-value">@topReferrer</div>
                                </div>
                            </div>

                            <div class="analytics-chart-grid">
                                <div class="analytics-chart-card">
                                    <div class="analytics-card-title">Clicks by hour</div>
                                    @if (totalClicks == 0)
                                    {
                                        <div class="empty-analytics">No clicks recorded for this link yet.</div>
                                    }
                                    else
                                    {
                                        var hourLabels = hourlyStats.Select(item => $"{item.Hour:00}:00").ToList();
                                        var hourValues = hourlyStats.Select(item => item.Count).ToList();
                                        <div class="trade-chart-shell">
                                            <canvas class="hour-line-chart"></canvas>
                                            <script type="application/json" class="hour-chart-data">
                                                                                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { labels = hourLabels, values = hourValues }))
                                            </script>
                                        </div>
                                    }
                                </div>

                                <div class="analytics-chart-card">
                                    <div class="analytics-card-title">Clicks by city</div>
                                    @if (!cityStats.Any())
                                    {
                                        <div class="empty-analytics">No city data is available for this link.</div>
                                    }
                                    else
                                    {
                                        var cityLabels = cityStats.Select(item => item.City).ToList();
                                        var cityValues = cityStats.Select(item => item.Count).ToList();
                                        <div class="city-chart-shell">
                                            <canvas class="city-bar-chart"></canvas>
                                            <script type="application/json" class="city-chart-data">
                                                                                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { labels = cityLabels, values = cityValues }))
                                            </script>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="analytics-table-card">
                                <div class="analytics-card-title">Recent clicks</div>
                                @if (!logs.Any())
                                {
                                    <div class="empty-analytics">No activity is available for this link yet.</div>
                                }
                                else
                                {
                                    <div class="analytics-table-wrap">
                                        <table class="analytics-log-table">
                                            <thead>
                                                <tr>
                                                    <th>Time</th>
                                                    <th>City</th>
                                                    <th>Country</th>
                                                    <th>Device</th>
                                                    <th>Browser</th>
                                                    <th>Operating system</th>
                                                    <th>Referrer</th>
                                                    <th>IP</th>
                                                    <th>User Agent</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var log in logs.Take(50))
                                                {
                                                    <tr>
                                                        <td>@ToIranTime(log.ClickedAt).ToString("yyyy/MM/dd HH:mm")</td>
                                                        <td>@(string.IsNullOrWhiteSpace(log.City) ? "Unknown" : log.City)</td>
                                                        <td>@(string.IsNullOrWhiteSpace(log.Country) ? "Unknown" : log.Country)</td>
                                                        <td>@log.DeviceType</td>
                                                        <td>@(string.IsNullOrWhiteSpace(log.Browser) ? "Unknown" : log.Browser)</td>
                                                        <td>@(string.IsNullOrWhiteSpace(log.Os) ? "Unknown" : log.Os)</td>
                                                        <td class="ltr-cell">@(string.IsNullOrWhiteSpace(log.Referre) ? "Direct" : log.Referre)</td>
                                                        <td class="ltr-cell">@(string.IsNullOrWhiteSpace(log.IpAddress) ? "Unknown" : log.IpAddress)</td>
                                                        <td class="ltr-cell">@(string.IsNullOrWhiteSpace(log.UserAgent) ? "Unknown" : log.UserAgent)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Profile Page -->
        <section id="profile" class="page-section">
            <div class="profile-container">
                <div class="profile-card">
                    <div class="profile-info">
                        <img src="/Images/Icons/ProfileIcon.png" class="icon icon-Logo " alt="Payvand Logo">
                        <div>
                            <h3 style="margin-bottom: 0.5rem; color: var(--text-main);">
                                @if (!string.IsNullOrEmpty(Model.DisplayName))
                                {
                                    @Model.DisplayName

                                }
                                else
                                {
                                    @Model.UserName
                                }

                            </h3>
                            <p style="color: var(--text-muted);">Member since @ToPersianDate(Model.CreatedAt)</p>
                        </div>
                    </div>

   
                    <form asp-action="ChangeUserName" asp-controller="Dashboard" method="post" id="changeUserNameForm" data-pv-validate="true" data-pv-disable-submit="true" data-pv-error="Enter a valid username.">

                        <input type="hidden" value="@Model.UserId" asp-for="UserId" />
                        <label class="form-label" asp-for="@Model.DisplayName">Username</label>
                        <input type="text" class="form-input" asp-for="@Model.DisplayName" value="@Model.DisplayName" placeholder="User_123" data-pv-required="true" data-pv-username="true" data-pv-unique-url="@Url.Action("CheckDisplayName", "Dashboard")">
                        <span class="pv-field-error">@TempData["ChangeUserNameError"]</span>

                 
                        <button class="save-btn-usname" type="submit">
                            <i class="fas fa-save"></i>
                            Save changes
                        </button>
                    </form>

   
                    <label class="form-label">Google account email</label>
                    <input type="email" class="form-input" value="@Model.Email" readonly dir="ltr">

                </div>
            </div>
        </section>
    </main>

    <!-- Bottom Navigation (Mobile) -->
    <nav class="bottom-nav">
        <a href="#dashboard" class="bottom-nav-item active" data-page="dashboard">
            <i class="fas fa-home bottom-nav-icon"></i>
            <span class="bottom-nav-text">Home</span>
        </a>

        <a href="#links" class="bottom-nav-item" data-page="links">
            <i class="fas fa-link bottom-nav-icon"></i>
            <span class="bottom-nav-text">Links</span>
        </a>

        <a href="#create" class="bottom-nav-item" data-page="create">
            <div class="create-link-btn">
                <i class="fas fa-plus"></i>
            </div>
            <span class="bottom-nav-text create-text">Create</span>
        </a>

        <a href="#analytics" class="bottom-nav-item" data-page="analytics">
            <i class="fas fa-chart-line bottom-nav-icon"></i>
            <span class="bottom-nav-text">Analytics</span>
        </a>

        <a href="#profile" class="bottom-nav-item" data-page="profile">
            <i class="fas fa-user bottom-nav-icon"></i>
            <span class="bottom-nav-text">Profile</span>
        </a>
    </nav>
    <div id="logoutModal" class="logout-modal hidden" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
        <div class="logout-dialog">
            <div class="logout-dialog-icon">
                <i class="fas fa-sign-out-alt"></i>
            </div>
            <div id="logoutModalTitle" class="logout-dialog-title">Sign out</div>
            <div class="logout-dialog-message">Sign out of the dashboard?</div>
            <div class="logout-dialog-actions">
                <button type="button" id="confirmLogout" class="logout-dialog-btn confirm">Yes</button>
                <button type="button" id="cancelLogout" class="logout-dialog-btn cancel">No</button>
            </div>
        </div>
    </div>
    <form asp-action="Logout" asp-controller="Account" method="post" id="logoutForm" hidden></form>

    <!-- Overlay wrapper -->
    @* <section class="link-shortener-section">
        ...
        </div> *@

    <!-- Global Toast -->
    <div id="toast" class="toast">
        <i class="fas fa-check-circle toast-icon"></i>
        <span id="toastMessage"></span>
        <button id="closeToast">&times;</button>
    </div>

    <script src="/js/vendor/chart.umd.min.js" asp-append-version="true"></script>
    <script src="/js/payvand-validation.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const navLinks = document.querySelectorAll('.nav-link, .bottom-nav-item, .view-all');
        const pageSections = document.querySelectorAll('.page-section');
        const searchLinks = document.getElementById('searchLinks');
        const logoutBtn = document.querySelector('.logout-btn');
        const mobileLogout = document.getElementById('mobile-logout');
        const shortenOther = document.getElementById('shortenother');
        const linkResult = document.getElementById('linkResult');
        const analyticsListView = document.getElementById('analyticsListView');
        const analyticsDetailView = document.getElementById('analyticsDetailView');
        const analyticsBackToList = document.getElementById('analyticsBackToList');
        const logoutModal = document.getElementById('logoutModal');
        const confirmLogout = document.getElementById('confirmLogout');
        const cancelLogout = document.getElementById('cancelLogout');
        const chartInstances = new Map();
        const qrForm = document.getElementById('qrForm');
        const qrId = document.getElementById('qrId');
        const qrSizeInput = document.getElementById('qrSizeInput');
        const qrShortenedLinkSelect = document.getElementById('qrShortenedLinkSelect');
        const qrLinkInput = document.getElementById('qrLinkInput');
        const qrForegroundColor = document.getElementById('qrForegroundColor');
        const qrBackgroundColor = document.getElementById('qrBackgroundColor');
        const qrLogoInput = document.getElementById('qrLogoInput');
        const qrCanvas = document.getElementById('qrPreviewCanvas');
        const qrPreviewText = document.getElementById('qrPreviewText');
        const qrPreviewShell = document.querySelector('.qr-preview-shell');
        const qrLinkSearch = document.getElementById('qrLinkSearch');
        const clearQrForm = document.getElementById('clearQrForm');
        let qrPreviewTimer = null;
        let qrPreviewRequest = null;

        function openLogoutModal() {
        logoutModal?.classList.remove('hidden');
        cancelLogout?.focus();
        }

        function closeLogoutModal() {
        logoutModal?.classList.add('hidden');
        }

        function selectedQrUrl() {
        const selectedOption = qrShortenedLinkSelect?.selectedOptions?.[0];
        return selectedOption?.dataset.url || qrLinkInput?.value?.trim() || '';
        }

        function drawQrPlaceholder(message) {
        if (!qrCanvas) return;
        const size = Number(qrSizeInput?.value || 300);
        qrCanvas.width = size;
        qrCanvas.height = size;
        const ctx = qrCanvas.getContext('2d');
        ctx.fillStyle = qrBackgroundColor?.value || '#ffffff';
        ctx.fillRect(0, 0, qrCanvas.width, qrCanvas.height);
        ctx.fillStyle = '#6c757d';
        ctx.font = '16px Vazirmatn, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(message, qrCanvas.width / 2, qrCanvas.height / 2);
        }

        async function updateQrPreview() {
        if (!qrCanvas || !qrForm) return;

        const url = selectedQrUrl();
        const size = Number(qrSizeInput?.value || 300);
        if (!url) {
        drawQrPlaceholder('Choose a link');
        if (qrPreviewText) qrPreviewText.textContent = 'Choose a short link or enter a direct URL to begin.';
        return;
        }

        qrPreviewRequest?.abort();
        qrPreviewRequest = new AbortController();
        const currentPreviewRequest = qrPreviewRequest;
        if (qrPreviewText) qrPreviewText.textContent = 'Creating preview...';
        window.PayvandLoader?.showInline(qrPreviewShell, 'Create preview');

        try {
        const response = await fetch('@Url.Action("QrCodePreview", "Dashboard")', {
        method: 'POST',
        body: new FormData(qrForm),
        credentials: 'same-origin',
        signal: currentPreviewRequest.signal
        });

        if (!response.ok) {
        throw new Error('Preview request failed');
        }

        const blob = await response.blob();
        const imageUrl = URL.createObjectURL(blob);
        const image = new Image();
        image.onload = function () {
        qrCanvas.width = size;
        qrCanvas.height = size;
        const ctx = qrCanvas.getContext('2d');
        ctx.clearRect(0, 0, qrCanvas.width, qrCanvas.height);
        ctx.drawImage(image, 0, 0, qrCanvas.width, qrCanvas.height);
        URL.revokeObjectURL(imageUrl);
        };
        image.src = imageUrl;
        if (qrPreviewText) qrPreviewText.textContent = `${size} × ${size} pixels`;
        } catch (error) {
        if (error.name === 'AbortError') return;
        drawQrPlaceholder('Could not create preview');
        if (qrPreviewText) qrPreviewText.textContent = 'Check the URL and QR code settings.';
        } finally {
        if (qrPreviewRequest === currentPreviewRequest) {
        window.PayvandLoader?.hideInline(qrPreviewShell);
        }
        }
        }

        function scheduleQrPreview() {
        clearTimeout(qrPreviewTimer);
        qrPreviewTimer = setTimeout(updateQrPreview, 250);
        }

        function setQrSize(size) {
        if (qrSizeInput) qrSizeInput.value = size;
        document.querySelectorAll('.qr-size-option').forEach(option => {
        option.classList.toggle('active', option.dataset.size === String(size));
        });
        scheduleQrPreview();
        }

        function pickQrLink(linkId, url) {
        if (qrShortenedLinkSelect) qrShortenedLinkSelect.value = linkId || '';
        if (qrLinkInput) qrLinkInput.value = linkId ? '' : (url || '');
        document.querySelectorAll('.qr-link-option').forEach(option => {
        option.classList.toggle('active', option.dataset.linkId === String(linkId));
        });
        scheduleQrPreview();
        }

        function resetQrForm() {
        if (qrForm) qrForm.reset();
        if (qrId) qrId.value = '0';
        setQrSize(300);
        pickQrLink('', '');
        if (qrForegroundColor) qrForegroundColor.value = '#000000';
        if (qrBackgroundColor) qrBackgroundColor.value = '#FFFFFF';
        scheduleQrPreview();
        }

        function readChartData(panel, selector) {
        const source = panel.querySelector(selector);
        if (!source) return null;

        try {
        return JSON.parse(source.textContent);
        } catch {
        return null;
        }
        }

        function buildGradient(ctx, area) {
        const gradient = ctx.createLinearGradient(0, area.top, 0, area.bottom);
        gradient.addColorStop(0, 'rgba(34, 197, 94, 0.32)');
        gradient.addColorStop(0.55, 'rgba(67, 97, 238, 0.12)');
        gradient.addColorStop(1, 'rgba(15, 23, 42, 0)');
        return gradient;
        }

        function initAnalyticsCharts(panel) {
        if (typeof Chart === 'undefined') return;

        const panelId = panel.dataset.analyticsDetailId;
        if (!panelId || chartInstances.has(panelId)) return;

        const hourData = readChartData(panel, '.hour-chart-data');
        const cityData = readChartData(panel, '.city-chart-data');
        const hourCanvas = panel.querySelector('.hour-line-chart');
        const cityCanvas = panel.querySelector('.city-bar-chart');
        const charts = [];

        if (hourData && hourCanvas) {
        const ctx = hourCanvas.getContext('2d');
        charts.push(new Chart(ctx, {
        type: 'line',
        data: {
        labels: hourData.labels,
        datasets: [{
        label: 'clicks',
        data: hourData.values,
        borderColor: '#22c55e',
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 5,
        pointBackgroundColor: '#0f172a',
        pointBorderColor: '#22c55e',
        pointBorderWidth: 2,
        tension: 0.36,
        fill: true,
        backgroundColor(context) {
        const chart = context.chart;
        const { ctx, chartArea } = chart;
        if (!chartArea) return 'rgba(34, 197, 94, 0.16)';
        return buildGradient(ctx, chartArea);
        }
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
        intersect: false,
        mode: 'index'
        },
        plugins: {
        legend: { display: false },
        tooltip: {
        rtl: true,
        backgroundColor: 'rgba(15, 23, 42, 0.92)',
        titleColor: '#e2e8f0',
        bodyColor: '#e2e8f0',
        borderColor: 'rgba(34, 197, 94, 0.45)',
        borderWidth: 1
        }
        },
        scales: {
        x: {
        grid: { color: 'rgba(148, 163, 184, 0.12)' },
        ticks: { color: '#94a3b8', maxRotation: 0, autoSkip: true, maxTicksLimit: 12 }
        },
        y: {
        beginAtZero: true,
        ticks: { color: '#94a3b8', precision: 0 },
        grid: { color: 'rgba(148, 163, 184, 0.14)' }
        }
        }
        }
        }));
        }

        if (cityData && cityCanvas) {
        charts.push(new Chart(cityCanvas.getContext('2d'), {
        type: 'bar',
        data: {
        labels: cityData.labels,
        datasets: [{
        label: 'clicks',
        data: cityData.values,
        borderRadius: 8,
        backgroundColor: '#4361ee',
        hoverBackgroundColor: '#7209b7'
        }]
        },
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        tooltip: {
        rtl: true,
        callbacks: {
        label(context) {
        return `${context.raw} clicks`;
        }
        }
        }
        },
        scales: {
        x: {
        beginAtZero: true,
        ticks: { precision: 0 },
        grid: { color: 'rgba(148, 163, 184, 0.18)' }
        },
        y: {
        grid: { display: false }
        }
        }
        }
        }));
        }

        chartInstances.set(panelId, charts);
        }

        function showAnalyticsList() {
        analyticsListView?.classList.remove('hidden');
        analyticsDetailView?.classList.add('hidden');
        document.querySelectorAll('.analytics-detail-panel').forEach(panel => {
        panel.classList.add('hidden');
        });
        }

        function showAnalyticsDetail(linkId, updateHash = true) {
        const card = document.querySelector(`[data-analytics-id="${linkId}"]`);
        const detailPanel = document.querySelector(`[data-analytics-detail-id="${linkId}"]`);
        if (!card || !detailPanel) {
        showAnalyticsList();
        showPage('analytics', updateHash);
        return;
        }

        analyticsListView?.classList.add('hidden');
        analyticsDetailView?.classList.remove('hidden');
        document.querySelectorAll('.analytics-detail-panel').forEach(panel => {
        panel.classList.toggle('hidden', panel !== detailPanel);
        });
        showPage('analytics', false, false);
        requestAnimationFrame(() => initAnalyticsCharts(detailPanel));

        if (updateHash) {
        history.replaceState(null, '', `#analytics-${linkId}`);
        }
        }

        function showPage(page, updateHash = true, resetAnalytics = true) {
        const targetSection = document.getElementById(page);
        if (!targetSection) return;

        navLinks.forEach(nav => nav.classList.remove('active'));
        document.querySelectorAll(`[data-page="${page}"]`).forEach(nav => nav.classList.add('active'));

        pageSections.forEach(section => {
        section.classList.toggle('active', section.id === page);
        });

        if (updateHash) {
        history.replaceState(null, '', `#${page}`);
        }

        if (page === 'analytics' && resetAnalytics) {
        showAnalyticsList();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        navLinks.forEach(link => {
        link.addEventListener('click', function (e) {
        const page = this.dataset.page;
        if (!page || page === 'logout') return;

        e.preventDefault();
        showPage(page);
        });
        });

        const initialPage = window.location.hash.replace('#', '');
        if (initialPage.startsWith('analytics-')) {
        showAnalyticsDetail(initialPage.replace('analytics-', ''), false);
        } else if (initialPage) {
        showPage(initialPage, false);
        }

        document.querySelectorAll('.analytics-link').forEach(link => {
        link.addEventListener('click', function (e) {
        e.preventDefault();
        showAnalyticsDetail(this.dataset.linkId);
        });
        });

        if (analyticsBackToList) {
        analyticsBackToList.addEventListener('click', function () {
        showAnalyticsList();
        showPage('analytics');
        });
        }

        if (linkResult && !linkResult.classList.contains('hidden')) {
        showPage('links', false);
        setTimeout(() => {
        linkResult.classList.add('hidden');
        }, 10000);
        }

        if (searchLinks) {
        searchLinks.addEventListener('input', function () {
        const searchTerm = this.value.toLowerCase().trim();
        document.querySelectorAll('#allLinksList .link-card').forEach(card => {
        card.style.display = card.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
        });
        });
        }

        qrShortenedLinkSelect?.addEventListener('change', function () {
        if (this.value && qrLinkInput) {
        qrLinkInput.value = '';
        }
        pickQrLink(this.value, selectedQrUrl());
        });

        qrLinkInput?.addEventListener('input', function () {
        if (this.value.trim() && qrShortenedLinkSelect) {
        qrShortenedLinkSelect.value = '';
        document.querySelectorAll('.qr-link-option').forEach(option => option.classList.remove('active'));
        }
        scheduleQrPreview();
        });

        qrForegroundColor?.addEventListener('input', scheduleQrPreview);
        qrBackgroundColor?.addEventListener('input', scheduleQrPreview);

        qrLogoInput?.addEventListener('change', function () {
        scheduleQrPreview();
        });

        document.querySelectorAll('.qr-size-option').forEach(option => {
        option.addEventListener('click', function () {
        setQrSize(this.dataset.size);
        });
        });

        document.querySelectorAll('.qr-pick-link').forEach(button => {
        button.addEventListener('click', function () {
        const item = this.closest('.qr-link-option');
        if (!item) return;
        pickQrLink(item.dataset.linkId, item.dataset.url);
        });
        });

        qrLinkSearch?.addEventListener('input', function () {
        const term = this.value.toLowerCase().trim();
        document.querySelectorAll('#qrLinkList .qr-link-option').forEach(item => {
        item.style.display = item.textContent.toLowerCase().includes(term) ? '' : 'none';
        });
        });

        document.querySelectorAll('.qr-edit-btn').forEach(button => {
        button.addEventListener('click', function () {
        if (qrId) qrId.value = this.dataset.id || '0';
        if (qrForegroundColor) qrForegroundColor.value = this.dataset.foreground || '#000000';
        if (qrBackgroundColor) qrBackgroundColor.value = this.dataset.background || '#FFFFFF';
        setQrSize(this.dataset.size || 300);
        pickQrLink(this.dataset.linkId || '', this.dataset.url || '');
        if (!this.dataset.linkId && qrLinkInput) {
        qrLinkInput.value = this.dataset.url || '';
        }
        if (qrLogoInput) qrLogoInput.value = '';
        showPage('create');
        scheduleQrPreview();
        });
        });

        document.querySelectorAll('.qr-delete-btn').forEach(button => {
        button.addEventListener('click', function (e) {
        if (!confirm('Delete this QR code?')) {
        e.preventDefault();
        }
        });
        });

        clearQrForm?.addEventListener('click', resetQrForm);

        document.addEventListener('click', function (e) {
        const copyButton = e.target.closest('.copy-btn, #Copybtn');
        if (!copyButton) return;

        const container = copyButton.closest('.link-item, .link-card, #Resultdiv, .qr-link-option');
        const linkText = container?.dataset.copyUrl?.trim()
        || container?.dataset.url?.trim()
        || container?.querySelector('.link-short')?.textContent?.trim()
        || container?.querySelector('.qr-link-short')?.textContent?.trim()
        || document.getElementById('ResultInput')?.value?.trim();

        if (!linkText) return;

        navigator.clipboard.writeText(linkText).then(() => {
        const original = copyButton.innerHTML;
        copyButton.innerHTML = '<i class="fas fa-check"></i>';
        copyButton.style.color = 'var(--success)';
        setTimeout(() => {
        copyButton.innerHTML = original;
        copyButton.style.color = '';
        }, 1500);
        });
        });

        if (shortenOther) {
        shortenOther.addEventListener('click', function () {
        const urlInput = document.getElementById('OriginalUrl');
        if (urlInput) {
        urlInput.value = '';
        urlInput.focus();
        }
        if (linkResult) {
        linkResult.classList.add('hidden');
        }
        });
        }

        if (logoutBtn) {
        logoutBtn.addEventListener('click', function (e) {
        e.preventDefault();
        openLogoutModal();
        });
        }

        if (mobileLogout && logoutBtn) {
        mobileLogout.addEventListener('click', function (e) {
        e.preventDefault();
        openLogoutModal();
        });
        }

        if (confirmLogout) {
        confirmLogout.addEventListener('click', function () {
        document.getElementById('logoutForm')?.requestSubmit();
        });
        }

        if (cancelLogout) {
        cancelLogout.addEventListener('click', closeLogoutModal);
        }

        if (logoutModal) {
        logoutModal.addEventListener('click', function (e) {
        if (e.target === logoutModal) {
        closeLogoutModal();
        }
        });
        }

        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && logoutModal && !logoutModal.classList.contains('hidden')) {
        closeLogoutModal();
        }
        });

        // ---- Toast notification ----
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        const closeToast = document.getElementById('closeToast');

        window.showToast = function (message) {
            if (!toast || !toastMessage) return;
            toastMessage.textContent = message;
            toast.classList.remove('hiding');
            toast.classList.add('show');
            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                toast.classList.add('hiding');
                setTimeout(() => {
                    toast.classList.remove('show', 'hiding');
                }, 400);
            }, 5000);
        };

        if (closeToast) {
            closeToast.addEventListener('click', function () {
                toast.classList.add('hiding');
                setTimeout(() => {
                    toast.classList.remove('show', 'hiding');
                }, 400);
            });
        }

        // Auto-show QR success toast on page load if TempData exists
        const qrSuccessMessage = document.getElementById('qrSuccessMessage');
        if (qrSuccessMessage && qrSuccessMessage.dataset.message) {
            showToast(qrSuccessMessage.dataset.message);
        }

        if (qrSizeInput && !qrSizeInput.value) {
            qrSizeInput.value = '300';
        }
        scheduleQrPreview();
        });
    </script>


</body>
</html>
