@{
    Layout = null;
}
@model DashboardViewModel
@{
    var isTemporaryGuest = User.FindFirst("auth_provider")?.Value == "temporary_guest";
}
@functions {
    private static readonly TimeZoneInfo IranTimeZone = GetIranTimeZone();

    private static TimeZoneInfo GetIranTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Asia/Tehran");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Iran Standard Time");
        }
    }

    private static DateTime ToIranTime(DateTime dateTime)
    {
        var utcDate = dateTime.Kind == DateTimeKind.Utc
            ? dateTime
            : DateTime.SpecifyKind(dateTime, DateTimeKind.Utc);

        return TimeZoneInfo.ConvertTimeFromUtc(utcDate, IranTimeZone);
    }

    private static string ToPersianDate(DateTime dateTime)
    {
        var iranTime = ToIranTime(dateTime);
        return iranTime.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    }

    private static string QrImageSrc(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        if (path.StartsWith("/"))
        {
            return path;
        }

        var normalized = path.Replace("\\", "/");
        const string marker = "/wwwroot/";
        var index = normalized.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (index >= 0)
        {
            return "/" + normalized.Substring(index + marker.Length).TrimStart('/');
        }

        return normalized;
    }
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Dashboard - Payvand</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" sizes="any" asp-append-version="true">
    <link rel="shortcut icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="/css/Dashboard/Dashboard.css" rel="stylesheet" asp-append-version="true" />

  
    <style>

            .hidden {
                display: none !important;
            }

            .result-container {
                margin: 0 10px 1.5rem;
                padding: 16px;
                border: 1px solid rgba(67, 97, 238, 0.18);
                border-radius: 12px;
                background: linear-gradient(135deg, rgba(67, 97, 238, 0.08), rgba(32, 201, 151, 0.08));
                box-shadow: 0 10px 26px rgba(17, 24, 39, 0.06);
                font-family: 'Vazirmatn', sans-serif;
            }

            .result-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 12px;
                color: var(--text-main);
                font-size: 0.95rem;
                font-weight: 700;
            }

                .result-header i {
                    color: var(--success);
                }

            #Resultdiv {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto auto;
                align-items: center;
                gap: 10px;
                width: 100%;
                direction: rtl;
            }

            #ResultInput {
                width: 100%;
                min-width: 0;
                padding: 12px 14px;
                border: 1px solid rgba(67, 97, 238, 0.22);
                border-radius: 10px;
                font-family: inherit;
                font-size: 14px;
                color: #4361ee;
                font-weight: 600;
                background: #ffffff;
                outline: none;
                transition: all 0.2s ease;
                box-sizing: border-box;
                cursor: default;
                direction: ltr;
                text-align: left;
            }

            #Copybtn,
            #shortenother {
                padding: 12px 20px;
                background: linear-gradient(135deg, #4361ee, #7209b7);
                color: white;
                border: none;
                border-radius: 10px;
                font-family: inherit;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
                gap: 6px;
                white-space: nowrap;
                min-height: 46px;
            }

            #shortenother {
                background: #ffffff;
                color: #4361ee;
                border: 1px solid rgba(67, 97, 238, 0.24);
            }

            .result-timer {
                margin-top: 10px;
                color: var(--text-muted);
                font-size: 0.82rem;
            }

            .analytics-list {
                display: grid;
                gap: 1rem;
            }

            .analytics-link-card {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: center;
                gap: 1rem;
                padding: 1rem;
                border: 1px solid rgba(67, 97, 238, 0.14);
                border-radius: 12px;
                background: #ffffff;
                box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
            }

            .analytics-link-main {
                min-width: 0;
            }

            .analytics-short {
                color: #4361ee;
                font-weight: 700;
                direction: ltr;
                text-align: left;
                overflow-wrap: anywhere;
            }

            .analytics-original {
                margin-top: 0.35rem;
                color: var(--text-muted);
                font-size: 0.9rem;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                direction: ltr;
                text-align: left;
            }

            .analytics-meta {
                display: flex;
                gap: 1rem;
                margin-top: 0.65rem;
                color: var(--text-muted);
                font-size: 0.85rem;
            }

            .analytics-view-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                min-height: 42px;
                padding: 10px 16px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(135deg, #4361ee, #7209b7);
                color: #ffffff;
                font-family: inherit;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
                white-space: nowrap;
            }

            .analytics-placeholder {
                padding: 1rem;
                border: 1px dashed rgba(67, 97, 238, 0.28);
                border-radius: 12px;
                background: rgba(67, 97, 238, 0.05);
            }

            .analytics-placeholder-title {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 0.75rem;
                color: var(--text-main);
                font-weight: 800;
            }

            .analytics-back-btn {
                margin-top: 1rem;
                border: 1px solid rgba(67, 97, 238, 0.24);
                border-radius: 10px;
                background: #ffffff;
                color: #4361ee;
                font-family: inherit;
                font-weight: 700;
                padding: 10px 14px;
                cursor: pointer;
            }

            .analytics-detail-panel {
                display: grid;
                gap: 1rem;
            }

            .analytics-summary-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 1rem;
            }

            .analytics-summary-card {
                padding: 1rem;
                border: 1px solid rgba(67, 97, 238, 0.12);
                border-radius: 12px;
                background: #ffffff;
                box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
            }

            .analytics-summary-label {
                color: var(--text-muted);
                font-size: 0.82rem;
            }

            .analytics-summary-value {
                margin-top: 0.45rem;
                color: var(--text-main);
                font-size: 1.25rem;
                font-weight: 800;
                overflow-wrap: anywhere;
            }

            .analytics-chart-grid {
                display: grid;
                grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);
                gap: 1rem;
            }

            .analytics-chart-card,
            .analytics-table-card {
                padding: 1rem;
                border: 1px solid rgba(67, 97, 238, 0.12);
                border-radius: 12px;
                background: #ffffff;
                box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
            }

            .analytics-card-title {
                margin-bottom: 1rem;
                color: var(--text-main);
                font-weight: 800;
            }

            .trade-chart-shell {
                position: relative;
                min-height: 320px;
                padding: 14px;
                border-radius: 12px;
                background: #0f172a;
                border: 1px solid rgba(148, 163, 184, 0.22);
                box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
            }

                .trade-chart-shell canvas {
                    width: 100% !important;
                    height: 290px !important;
                }

            .city-chart-shell {
                position: relative;
                min-height: 320px;
            }

                .city-chart-shell canvas {
                    width: 100% !important;
                    height: 290px !important;
                }

            .hour-chart {
                display: grid;
                grid-template-columns: repeat(24, minmax(18px, 1fr));
                align-items: end;
                gap: 6px;
                min-height: 220px;
                padding-top: 1rem;
                border-bottom: 1px solid #e9ecef;
            }

            .hour-bar-wrap {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-end;
                min-width: 0;
                height: 210px;
            }

            .hour-bar {
                width: 100%;
                min-height: 4px;
                border-radius: 8px 8px 0 0;
                background: linear-gradient(180deg, #4361ee, #20c997);
            }

            .hour-count {
                margin-bottom: 4px;
                color: var(--text-muted);
                font-size: 0.72rem;
            }

            .hour-label {
                margin-top: 6px;
                color: var(--text-muted);
                font-size: 0.7rem;
                writing-mode: vertical-rl;
            }

            .city-chart {
                display: grid;
                gap: 0.75rem;
            }

            .city-bar-row {
                display: grid;
                grid-template-columns: 90px minmax(0, 1fr) 34px;
                align-items: center;
                gap: 8px;
            }

            .city-name {
                color: var(--text-main);
                font-size: 0.85rem;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .city-track {
                height: 10px;
                overflow: hidden;
                border-radius: 99px;
                background: #edf2ff;
            }

            .city-bar {
                height: 100%;
                border-radius: inherit;
                background: linear-gradient(135deg, #7209b7, #4361ee);
            }

            .city-count {
                color: var(--text-muted);
                font-size: 0.8rem;
                text-align: left;
            }

            .analytics-table-wrap {
                overflow-x: auto;
            }

            .analytics-log-table {
                width: 100%;
                min-width: 900px;
                border-collapse: collapse;
            }

                .analytics-log-table th,
                .analytics-log-table td {
                    padding: 0.8rem;
                    border-bottom: 1px solid #edf2f7;
                    color: var(--text-main);
                    font-size: 0.85rem;
                    text-align: right;
                    vertical-align: top;
                }

                .analytics-log-table th {
                    color: var(--text-muted);
                    font-weight: 700;
                    background: #f8f9fa;
                }

            .ltr-cell {
                direction: ltr;
                text-align: left !important;
                max-width: 240px;
                overflow-wrap: anywhere;
            }

            .empty-analytics {
                padding: 1.25rem;
                border: 1px dashed rgba(67, 97, 238, 0.24);
                border-radius: 12px;
                color: var(--text-muted);
                background: rgba(67, 97, 238, 0.04);
            }

            .logout-modal {
                position: fixed;
                inset: 0;
                z-index: 2000;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1rem;
                background: rgba(15, 23, 42, 0.55);
                backdrop-filter: blur(4px);
            }

            .logout-dialog {
                width: min(420px, 100%);
                padding: 1.5rem;
                border-radius: 14px;
                background: #ffffff;
                box-shadow: 0 24px 70px rgba(15, 23, 42, 0.24);
                text-align: center;
                font-family: 'Vazirmatn', sans-serif;
            }

            .logout-dialog-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 52px;
                height: 52px;
                margin-bottom: 1rem;
                border-radius: 50%;
                background: rgba(239, 68, 68, 0.1);
                color: #ef4444;
                font-size: 1.3rem;
            }

            .logout-dialog-title {
                margin-bottom: 0.5rem;
                color: var(--text-main);
                font-size: 1.1rem;
                font-weight: 800;
            }

            .logout-dialog-message {
                margin-bottom: 1.25rem;
                color: var(--text-muted);
                line-height: 1.8;
            }

            .logout-dialog-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.75rem;
            }

            .logout-dialog-btn {
                min-height: 44px;
                border-radius: 10px;
                border: none;
                font-family: inherit;
                font-weight: 800;
                cursor: pointer;
            }

                .logout-dialog-btn.confirm {
                    background: #ef4444;
                    color: #ffffff;
                }

                .logout-dialog-btn.cancel {
                    background: #f1f5f9;
                    color: var(--text-main);
                }

            .qr-dashboard-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
                gap: 1rem;
                align-items: start;
            }

            .qr-panel {
                background: #ffffff;
                border: 1px solid rgba(67, 97, 238, 0.12);
                border-radius: 12px;
                padding: 1.25rem;
                box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
                margin-bottom: 1rem;
            }

            .qr-panel-title {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                margin-bottom: 1rem;
                color: var(--text-main);
                font-weight: 800;
            }

                .qr-panel-title span {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                }

            .qr-form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 1rem;
            }

            .qr-color-row {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.75rem;
            }

            .qr-color-control {
                display: grid;
                grid-template-columns: 44px minmax(0, 1fr);
                align-items: center;
                gap: 0.75rem;
                padding: 0.65rem;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--bg-main);
            }

                .qr-color-control input[type="color"] {
                    width: 44px;
                    height: 44px;
                    padding: 0;
                    border: none;
                    border-radius: 8px;
                    background: transparent;
                    cursor: pointer;
                }

            .qr-size-options {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 0.5rem;
            }

            .qr-size-option {
                min-height: 42px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: #ffffff;
                color: var(--text-main);
                font-family: inherit;
                font-weight: 700;
                cursor: pointer;
            }

                .qr-size-option.active {
                    border-color: var(--primary);
                    color: var(--primary);
                    background: rgba(67, 97, 238, 0.08);
                }

            .qr-preview-shell {
                display: grid;
                gap: 0.75rem;
                justify-items: center;
                padding: 1rem;
                border: 1px dashed rgba(67, 97, 238, 0.28);
                border-radius: 12px;
                background: rgba(67, 97, 238, 0.04);
            }

            #qrPreviewCanvas {
                width: min(280px, 100%);
                aspect-ratio: 1;
                height: auto;
                border-radius: 8px;
                background: #ffffff;
                box-shadow: 0 12px 30px rgba(17, 24, 39, 0.08);
            }

            .qr-help-text {
                color: var(--text-muted);
                font-size: 0.82rem;
            }

            .qr-link-list,
            .qr-grid {
                display: grid;
                gap: 0.75rem;
            }

            .qr-link-list {
                max-height: 360px;
                overflow: auto;
                padding-left: 0.25rem;
            }

            .qr-link-option {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: center;
                gap: 0.75rem;
                padding: 0.85rem;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--bg-main);
            }

                .qr-link-option.active {
                    border-color: var(--primary);
                    background: rgba(67, 97, 238, 0.08);
                }

            .qr-link-short,
            .qr-link-original,
            .qr-card-link {
                direction: ltr;
                text-align: left;
                overflow-wrap: anywhere;
            }

            .qr-link-short {
                color: var(--primary);
                font-weight: 800;
            }

            .qr-link-original {
                margin-top: 0.25rem;
                color: var(--text-muted);
                font-size: 0.82rem;
            }

            .qr-inline-actions {
                display: flex;
                gap: 0.4rem;
            }

            .qr-action-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: #ffffff;
                color: var(--text-muted);
                cursor: pointer;
                text-decoration: none;
            }

                .qr-action-btn:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                }

                .qr-action-btn.delete:hover {
                    border-color: var(--error);
                    color: var(--error);
                }

            .qr-card {
                display: grid;
                grid-template-columns: 86px minmax(0, 1fr) auto;
                gap: 0.8rem;
                align-items: center;
                padding: 0.75rem;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--bg-main);
            }

                .qr-card img {
                    width: 86px;
                    height: 86px;
                    object-fit: contain;
                    border-radius: 8px;
                    background: #ffffff;
                }

            .qr-status {
                margin-bottom: 1rem;
                padding: 0.85rem 1rem;
                border-radius: 10px;
                font-weight: 700;
            }

                .qr-status.success {
                    color: #166534;
                    background: #dcfce7;
                }

                .qr-status.error {
                    color: #991b1b;
                    background: #fee2e2;
                }

            @@media (max-width: 768px) {
                #Resultdiv {
                    grid-template-columns: 1fr;
                }

                #Copybtn,
                #shortenother {
                    justify-content: center;
                    width: 100%;
                }

                .analytics-link-card {
                    grid-template-columns: 1fr;
                }

                .analytics-view-btn {
                    width: 100%;
                }

                .analytics-summary-grid,
                .analytics-chart-grid,
                .qr-dashboard-grid,
                .qr-form-grid {
                    grid-template-columns: 1fr;
                }

                .analytics-meta,
                .qr-inline-actions {
                    flex-wrap: wrap;
                }

                .analytics-summary-card,
                .analytics-chart-card,
                .analytics-table-card,
                .qr-panel {
                    padding: 0.9rem;
                }

                .qr-card {
                    grid-template-columns: 72px minmax(0, 1fr);
                    align-items: start;
                }

                    .qr-card img {
                        width: 72px;
                        height: 72px;
                    }

                    .qr-card .qr-inline-actions {
                        grid-column: 1 / -1;
                        justify-content: stretch;
                    }

                        .qr-card .qr-inline-actions .qr-action-btn,
                        .qr-card .qr-inline-actions form {
                            flex: 1;
                        }

                        .qr-card .qr-inline-actions .qr-action-btn {
                            width: 100%;
                        }

                .qr-color-row,
                .qr-size-options {
                    grid-template-columns: 1fr;
                }

                .hour-chart {
                    overflow-x: auto;
                    grid-template-columns: repeat(24, 28px);
                    padding-bottom: 0.5rem;
                }
            }

            @@media (max-width: 420px) {
                .qr-link-option {
                    grid-template-columns: 1fr;
                }

                    .qr-link-option .qr-inline-actions {
                        justify-content: stretch;
                    }

                    .qr-link-option .qr-action-btn {
                        flex: 1;
                        width: 100%;
                    }

                .logout-dialog-actions {
                    grid-template-columns: 1fr;
                }
            }

    </style>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/english.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="dashboard-header">
        <a href="/" style="text-decoration:none;">
            <div class="logo">

                <img src="/Images/Logo/logo.png" class="icon icon-md" alt="Alternate Text" />

                <span class="logo-text">Payvand</span>
            </div>
        </a>


        <div class="user-profile">
            @* <div class="user-avatar"> *@

            <img src="/Images/Icons/ProfileIcon.png" class="icon icon-md " alt="Payvand Logo">
            @* </div> *@
            <div class="user-info">
                <div class="user-name">
                    @if (!string.IsNullOrEmpty(Model.DisplayName))
                    {
                        @Model.DisplayName

                    }
                    else
                    {
                        @Model.UserName
                    }
                </div>
                <div class="user-phone">@Model.PhoneNumber</div>
            </div>
            @if (!isTemporaryGuest)
            {
                <button class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    Sign out
                </button>
            }
        </div>
    </header>

    <!-- Sidebar (Desktop) -->
    <aside class="dashboard-sidebar">
        <nav>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="#dashboard" class="nav-link active  " data-page="dashboard">
                        <i class="fas fa-home nav-icon"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#links" class="nav-link " data-page="links">
                        <i class="fas fa-link nav-icon"></i>
                        <span>My links</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#create" class="nav-link" data-page="create">
                        <i class="fas fa-plus-circle nav-icon"></i>
                        <span>Create QR code</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#analytics" class="nav-link" data-page="analytics">
                        <i class="fas fa-chart-line nav-icon"></i>
                        <span>Analytics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#profile" class="nav-link" data-page="profile">
                        <i class="fas fa-user nav-icon"></i>
                        <span>Profile</span>
                    </a>
                </li>
                @if (!isTemporaryGuest)
                {
                    <li class="nav-item">
                        <a href="#logout" class="nav-link" id="mobile-logout">
                            <i class="fas fa-sign-out-alt nav-icon"></i>
                            <span>Sign out</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
