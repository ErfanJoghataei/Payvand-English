@{
    Layout = null;
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var error = ViewData["Error"] as string;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Sign in - Payvand</title>
    <link rel="icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <main class="login-container">
        <a href="/" class="logo-section">
            <div class="logo-icon">
                <img src="/Images/Logo/logo.png" class="icon icon-Logo" alt="Payvand logo">
            </div>
            <h1 class="logo-title">Payvand</h1>
            <p class="logo-subtitle">A smarter way to share links</p>
        </a>

        <section class="login-card" aria-labelledby="login-title">
            <h2 class="card-title" id="login-title">Sign in to your account</h2>
            <p class="card-description">Continue securely with your Google account.</p>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="error-message show" role="alert">@error</div>
            }

            @if (googleEnabled)
            {
                <form asp-action="GoogleLogin" asp-controller="Account" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl">
                    <button type="submit" class="google-button">
                        <svg class="google-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.91h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.4z"/>
                            <path fill="#34A853" d="M12 22c2.7 0 4.98-.9 6.63-2.43l-3.24-2.54c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22z"/>
                            <path fill="#FBBC05" d="M6.39 13.86A6 6 0 0 1 6.08 12c0-.65.11-1.28.31-1.86V7.52H3.04A10 10 0 0 0 2 12c0 1.61.38 3.13 1.04 4.48l3.35-2.62z"/>
                            <path fill="#EA4335" d="M12 6.01c1.47 0 2.79.5 3.83 1.5l2.87-2.87A9.64 9.64 0 0 0 12 2a10 10 0 0 0-8.96 5.52l3.35 2.62C7.18 7.77 9.39 6.01 12 6.01z"/>
                        </svg>
                        Continue with Google
                    </button>
                </form>
            }
            else
            {
                <div class="error-message show" role="alert">
                    Google sign in is not configured on this server.
                </div>
            }

            <div class="input-hint">
                Sign in to keep your link history. Guest usage is limited.
            </div>

            <footer class="login-footer">
                <p class="privacy-notice">
                    By signing in, you agree to the <a href="@Url.Action("Terms", "Terms_Privacy")">Terms of use</a> and
                    <a href="@Url.Action("Privacy", "Terms_Privacy")">Privacy Policy</a>.
                </p>
            </footer>
        </section>
    </main>
</body>
</html>
