
@{
    Layout = null;
}
@model RequestResetPassViewModel
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Change password - Payvand</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" sizes="any" asp-append-version="true">
    <link rel="shortcut icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Account/Login.css" asp-append-version="true">

        <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    </head>
    <body>
        <div class="login-container">
            <a href="/" class="logo-section" style="display:block;text-decoration:none;color:inherit;">
                <div class="logo-icon">
                    <i class="fas fa-link"></i>
                </div>
                <h1 class="logo-title">Payvand</h1>
                <p class="logo-subtitle">A smarter way to share links</p>
            </a>

            <div class="login-card">
                <h2 class="card-title">Change password</h2>
                <p class="card-description">Enter your phone number to reset your password.</p>

                <div class="error-message" id="errorMessage">
                    Enter a valid mobile number.
                </div>

                <form asp-action="ResetPassRequestPost" asp-controller="Account" data-pv-validate="true" data-pv-disable-submit="true" data-pv-error="Enter a valid mobile number.">
                    <div class="form-group">
                        <label class="form-label" asp-for="PhoneNumber">Mobile number</label>
                        <div class="input-wrapper">
                            <i class="fas fa-mobile-alt input-icon"></i>
                            <input type="tel"
                                   class="form-input"
                                   placeholder="09123456789"
                                   autocomplete="tel" asp-for="PhoneNumber"
                                   data-pv-required="true"
                                   data-pv-phone="true">
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                   </div>

                        <button type="submit" class="submit-button">
                            <span id="buttonText">Send verification code</span>
 
                        </button>
                </form>


                
            </div>

        <script src="/js/payvand-validation.js" asp-append-version="true"></script>
        </body>
    </html>
