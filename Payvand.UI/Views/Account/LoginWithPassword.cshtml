@{
    Layout = null;
}
@model PasswordLogin
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Sign in with password</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" sizes="any" asp-append-version="true">
    <link rel="shortcut icon" href="/favicon.ico" asp-append-version="true">
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/Fonts/Vazirmatn.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="/css/Account/LoginWithPassword.css" asp-append-version="true" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <a href="/" class="logo-section" style="display:block;text-decoration:none;color:inherit;">
            <div class="logo-icon">
                <i class="fas fa-link"></i>
            </div>
            <h1 class="logo-title">Payvand</h1>
            <p class="logo-subtitle">A smarter way to share links</p>
        </a>
       

        <div class="login-card">
            <h2 class="card-title">Sign in with password</h2>
            <p class="card-description">Enter your account password.</p>

            <div class="error-message" id="errorMessage">
                <i class="fas fa-exclamation-circle"></i>
                <span id="errorText">Enter your password.</span>
            </div>
            <form asp-action="LoginWithPasswordPost" asp-controller="Account" method="post" id="passwordForm" data-pv-validate="true" data-pv-disable-submit="true" data-pv-error="Enter a valid password.">
                <div class="form-group">
                    <label class="form-label" asp-for="Password">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="hidden" asp-for="PhoneNumber" />
                  

                        <input type="password"
                               asp-for="Password"
                               class="form-input"
                               id="nigga"
                               placeholder="Password"
                               autocomplete="current-password"
                               data-pv-required="true"
                               data-pv-password="true">

                            <button type="button" class="password-toggle" id="togglePassword">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <div asp-validation-summary="All" class="validation-summary"></div>
                    </div>

                    <button type="submit" class="submit-button">
                        <span id="buttonText">Sign in</span>
                    </button>
                </form>


            <div class="links-section">
                    <a style="text-decoration:none;" asp-action="ResetPassRequest" asp-controller="Account" class="link" >
                    <i class="fas fa-key"></i>
                    <span>Forgot password?</span>
                </a>

                    <a style="text-decoration:none;" asp-action="LoginWithOTP" asp-controller="Account" asp-route-PhoneNumber="@Model.PhoneNumber">
                    <button class="link" id="backButton">
                    <i class="fas fa-arrow-right"></i>
                    <span>Back</span>
                    </button>
               </a>

            </div>
        </div>
    </div>

        <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const passwordInput = document.getElementById('nigga'); // input پسورد
                    const passwordForm = document.getElementById('passwordForm'); // فرم
                    const togglePassword = document.getElementById('togglePassword'); // دکمه چشم

                    // فوکوس اولیه روی input
                    passwordInput.focus();

                    // Toggle پسورد
                    togglePassword.addEventListener('click', function() {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);

                        const icon = togglePassword.querySelector('i');
                        if (type === 'text') {
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    });

                    // Enter برای فرم
                    passwordInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            passwordForm.requestSubmit();
                        }
                    });

                    // ===== برای OTP ۶ رقمی =====
                    const otpInputs = document.querySelectorAll('.otp-input');
                    const codeHidden = document.getElementById('CodeHidden');

                    otpInputs.forEach((input, index) => {
                        input.addEventListener('input', () => {
                            let code = '';
                            otpInputs.forEach(i => code += i.value);
                            codeHidden.value = code; // آپدیت hidden

                            // اگر همه پر بودن خودکار submit کن
                            if (code.length === otpInputs.length) {
                                passwordForm.submit(); // فرم submit میشه
                            }

                            // فوکوس روی input بعدی
                            if (index < otpInputs.length - 1 && input.value.length === 1) {
                                otpInputs[index + 1].focus();
                            }
                        });

                        // Backspace برای برگشت به input قبلی
                        input.addEventListener('keydown', (e) => {
                            if (e.key === 'Backspace' && input.value === '' && index > 0) {
                                otpInputs[index - 1].focus();
                            }
                        });
                    });
                });
        </script>
        <script src="/js/payvand-validation.js" asp-append-version="true"></script>


</body>
</html>
